  "cards": [
    { "dot": "cyan", "title": "无前视对齐", "items": [
      "信号在全历史（2015 年起）上滚动计算，循环按日期 d 用 .loc[d] 取值",
      "shift_weights 把目标权重整体 shift(1)（T 日信号、T+1 生效），缺日补 0",
      "组合波动量只用「上一日最终权重 × 当日收益」构造，不含未来信息"
    ] },
    { "dot": "emerald", "title": "引擎口径与机制", "items": [
      "默认 open：T+1 开盘成交 + 跳空顺延 + 停牌跳过；close 回退 T+1 收盘近似",
      "mechanisms 开关（phases/hysteresis/reversal/overheat/vol_cap）默认全 on",
      "bt 负责现金、持仓、换手与净值记账；成本为单边 bps 佣金，现金按年化计息"
    ] },
    { "dot": "rose", "title": "登记与观测", "items": [
